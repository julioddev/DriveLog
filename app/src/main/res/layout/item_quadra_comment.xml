<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="4dp"
    android:paddingHorizontal="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/textCommentUser"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Carlos"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"/>

        <TextView
            android:id="@+id/textCommentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10 min"
            android:textSize="10sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginEnd="8dp"/>

        <ImageButton
            android:id="@+id/btnDeleteComment"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_delete"
            app:tint="#F44336"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="Excluir Comentário"/>
    </LinearLayout>

    <TextView
        android:id="@+id/textCommentBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fica logo após a feira coberta, bloco B."
        android:textSize="12sp"
        android:textColor="#333333"
        android:layout_marginTop="2dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F0F0F0"
        android:layout_marginTop="6dp"/>
</LinearLayout>
