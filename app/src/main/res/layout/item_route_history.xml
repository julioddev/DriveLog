<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textRouteName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nome da Rota"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"/>

            <TextView
                android:id="@+id/textRouteDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="00/00/0000 00:00"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/textRouteStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Em andamento"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:layout_marginTop="2dp"
                android:visibility="gone"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnEditRouteName"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="?attr/colorPrimary"
            android:contentDescription="Editar Nome" />

        <ImageButton
            android:id="@+id/btnDeleteRoute"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@android:color/holo_red_dark"
            android:contentDescription="Excluir Rota" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>