<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#EEEEEE"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/imgFriendAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_circle_primary"
                android:contentDescription="Foto do amigo" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textFriendName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nome do Colega"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textFriendStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Amigo Parceiro"
                android:textSize="11sp"
                android:textColor="#888888" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutFriendActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAcceptFriend"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Aceitar"
                android:textSize="10sp"
                android:paddingHorizontal="8dp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnDeleteFriend"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="@android:color/holo_red_dark"
                android:contentDescription="Remover amigo" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>