<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Linha Divisória de Grupo -->
    <View
        android:id="@+id/viewGroupDivider"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:layout_marginHorizontal="16dp"
        android:background="?attr/colorPrimary"
        android:visibility="gone"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardListStop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="4dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp"
        app:strokeColor="@android:color/transparent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <CheckBox
                android:id="@+id/checkListUnify"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginEnd="4dp"
                android:clickable="false"
                android:focusable="false"/>

            <TextView
                android:id="@+id/textListNumber"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_circle_primary"
                android:gravity="center"
                android:text="1"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginEnd="12dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textListAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Endereço"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:ellipsize="end"
                    android:maxLines="1"/>

                <TextView
                    android:id="@+id/textListRawAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Endereço Original"
                    android:textSize="11sp"
                    android:textStyle="italic"
                    android:textColor="#888888"
                    android:visibility="gone"
                    android:ellipsize="end"
                    android:maxLines="1"/>

                <TextView
                    android:id="@+id/textListNeighborhood"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bairro"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:ellipsize="end"
                    android:maxLines="1"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/textListStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pendente"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/textListDownloadedStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(Correção disponível)"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginStart="6dp"
                        android:visibility="gone"
                        android:textColor="#F44336"/>

                    <!-- Área de Feedback Global -->
                    <LinearLayout
                        android:id="@+id/layoutListGlobalFeedback"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="1dp"
                        android:background="#10FBC02D"
                        android:layout_marginStart="6dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:src="@android:drawable/btn_star_big_on"
                            app:tint="#FBC02D" />

                        <TextView
                            android:id="@+id/textListGlobalStats"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 👍 | 0 👎"
                            android:textSize="9sp"
                            android:textColor="#FBC02D"
                            android:textStyle="bold"
                            android:layout_marginStart="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/imageListStatus"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/checkbox_on_background"
                app:tint="?attr/colorPrimary"
                android:contentDescription="Status"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>