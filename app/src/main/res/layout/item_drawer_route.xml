<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/iconRoute"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_map"
        android:layout_marginEnd="16dp"
        app:tint="?attr/colorPrimary"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textDrawerRouteName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nome da Rota"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <TextView
            android:id="@+id/textDrawerRouteDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Data da Rota"
            android:textSize="11sp"
            android:textColor="#888888"/>
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnEditRoute"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_edit"
        app:tint="#888888"
        android:contentDescription="Editar Rota"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <ImageButton
        android:id="@+id/btnDeleteRoute"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_delete"
        app:tint="#D32F2F"
        android:contentDescription="Excluir Rota"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

</LinearLayout>
