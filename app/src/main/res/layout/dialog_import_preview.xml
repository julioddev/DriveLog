<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Cabeçalho do Diálogo -->
        <TextView
            android:id="@+id/textImportPreviewTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📋 Prévia da Rota Importada"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verifique as paradas. Reordene, unifique ou remova itens antes de confirmar."
            android:textSize="11sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp" />

        <!-- Opções Compactas de Otimização e Ponto de Partida -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorSurfaceVariant"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- 1. Motor de Otimização Drop-list -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚡ Motor de Otimização:"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary" />

                <Spinner
                    android:id="@+id/spinnerOptEngine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    android:layout_marginBottom="4dp" />

                <!-- 2. Ponto de Partida Drop-list -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📍 Ponto de Partida:"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary" />

                <Spinner
                    android:id="@+id/spinnerStartMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp" />

                <!-- Seletor de Parada Inicial -->
                <LinearLayout
                    android:id="@+id/layoutStartStopPicker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Selecione a primeira parada (#1):"
                        android:textSize="11sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:layout_marginBottom="2dp" />

                    <Spinner
                        android:id="@+id/spinnerStartStop"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="36dp" />
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Balão de Sugestões de Agrupamento -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGroupingSuggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#2196F3"
            app:cardBackgroundColor="#E3F2FD"
            android:visibility="gone"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@android:drawable/ic_dialog_info"
                    app:tint="#1976D2"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/textGroupingSuggestions"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💡 Sugestões de Agrupamento encontradas."
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#0D47A1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VER >"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2"
                    android:layout_marginStart="4dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Barra de Ações Rápidas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUnifyPreviewSelected"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Unificar (0)"
                android:textSize="11sp"
                app:icon="@android:drawable/checkbox_on_background"
                app:iconSize="16dp"
                android:paddingHorizontal="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectAllPreview"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Marcar Todos"
                android:textSize="11sp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Lista de Paradas na Prévia -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerImportPreview"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scrollbars="vertical"
            android:layout_marginBottom="10dp" />

        <!-- Botões de Ação do Diálogo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelImportPreview"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="FECHAR"
                android:textColor="#F44336"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmImportPreview"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="⚡ Otimizar e Iniciar Rota" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>