<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="8dp"
    android:paddingHorizontal="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/textDialogStopNumber"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_circle_primary"
            android:gravity="center"
            android:text="1"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginEnd="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textDialogStopAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Endereço"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/textDialogStopSeq"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Seq: 1, 2"
                android:textSize="11sp"
                android:textColor="#666666"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnDialogVehicleLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 Local ▾"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:background="@drawable/bg_vehicle_location_chip"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE"
        android:layout_marginTop="8dp" />
</LinearLayout>
