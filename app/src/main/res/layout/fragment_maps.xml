<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Botões Utilitários (Topo) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabDeliveryApp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/fabLoadingPoints"
        app:layout_constraintEnd_toEndOf="parent"
        android:src="@drawable/ic_map"
        app:backgroundTint="@android:color/white"
        app:tint="@null"
        android:visibility="gone"
        android:contentDescription="Abrir App de Entrega" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabLoadingPoints"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/fabHome"
        app:layout_constraintEnd_toEndOf="parent"
        android:src="@drawable/ic_money"
        app:tint="?attr/colorPrimary"
        app:backgroundTint="@android:color/white"
        android:contentDescription="Gerenciar Pontos de Carregamento" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/fabDownload"
        app:layout_constraintEnd_toEndOf="parent"
        android:src="@android:drawable/ic_menu_myplaces"
        app:tint="?attr/colorPrimary"
        app:backgroundTint="@android:color/white"
        android:contentDescription="Definir Localização da Casa" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabDownload"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/fabCenter"
        app:layout_constraintEnd_toEndOf="parent"
        android:src="@drawable/ic_download"
        app:backgroundTint="@android:color/white"
        android:contentDescription="Baixar Mapa para Offline" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/layoutTrackingControls"
        app:layout_constraintEnd_toEndOf="parent"
        android:src="@drawable/ic_my_location"
        app:backgroundTint="@android:color/white"
        android:contentDescription="Minha Localização" />

    <!-- Controles de Rastreamento (Base) -->
    <LinearLayout
        android:id="@+id/layoutTrackingControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabStop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_stop"
            app:backgroundTint="@android:color/holo_red_light"
            android:visibility="gone"
            android:contentDescription="Parar e Salvar" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabTracking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_play"
            app:backgroundTint="@android:color/holo_green_light"
            android:contentDescription="Iniciar/Pausar" />
    </LinearLayout>

    <TextView
        android:id="@+id/textTrackingStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="#80000000"
        android:padding="8dp"
        android:text="Rastreamento Desativado"
        android:textColor="@android:color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Aviso de Intervalo de Descanso -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardRestWarning"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardCornerRadius="8dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@android:color/holo_orange_light"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INTERVALO DE DESCANSO ATIVO"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:textSize="16sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A localização está pausada para economizar bateria."
                android:textColor="@android:color/black"
                android:layout_marginTop="4dp"
                android:gravity="center"/>
            <TextView
                android:id="@+id/btnDisableRestInMaps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CLIQUE AQUI PARA DESATIVAR"
                android:textStyle="bold"
                android:textColor="@android:color/holo_blue_dark"
                android:layout_marginTop="12dp"
                android:padding="8dp"
                android:background="?attr/selectableItemBackground"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Linha do Tempo (Aparece apenas no histórico) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTimeline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/layoutTrackingControls"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Linha do Tempo"
                    android:textStyle="bold"
                    android:textSize="12sp"/>
                <TextView
                    android:id="@+id/textTimelineTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00:00"
                    android:textSize="12sp"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginEnd="12dp"/>
                <LinearLayout
                    android:id="@+id/btnExitHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SAIR"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary"
                        android:layout_marginEnd="4dp"/>
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_close"
                        app:tint="?attr/colorPrimary"/>
                </LinearLayout>
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekBarTimeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <ImageView
                    android:id="@+id/btnTimelinePlayPause"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_play"
                    app:tint="?attr/colorPrimary"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Play/Pause" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="0dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/btnSpeed1x"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1x"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:padding="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless" />
                    <TextView
                        android:id="@+id/btnSpeed2x"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2x"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:padding="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless" />
                    <TextView
                        android:id="@+id/btnSpeed4x"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4x"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:padding="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless" />
                    <TextView
                        android:id="@+id/btnSpeed8x"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8x"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:padding="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
