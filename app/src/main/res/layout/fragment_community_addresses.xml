<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Correções da Comunidade"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"
        android:textColor="?attr/colorPrimary"/>

    <EditText
        android:id="@+id/editSearchCommunity"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Buscar endereço na comunidade..."
        android:background="@android:drawable/edit_text"
        android:paddingHorizontal="12dp"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="8dp"
        android:inputType="text"
        android:importantForAutofill="no"/>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshCommunity"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCommunity"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <TextView
        android:id="@+id/textEmptyCommunity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nenhuma correção global encontrada."
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginTop="32dp"/>
</LinearLayout>
