<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/root_container"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="30dp"
        app:cardElevation="2dp"
        app:cardPreventCornerOverlap="false"
        app:strokeWidth="0dp"
        app:strokeColor="@android:color/transparent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressCpfTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:indicatorSize="58dp"
                app:trackThickness="3.5dp"
                app:trackColor="#E0E0E0"
                app:indicatorColor="#2196F3"
                android:max="100"
                android:progress="0"
                android:visibility="gone" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="10dp"
                android:src="@mipmap/ic_launcher_round"
                android:scaleType="fitCenter" />

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Botão de Pause/Play (Só visível no long-press se for DEV) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btn_pause_play"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginStart="8dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:cardBackgroundColor="#F5F5F5"
        app:cardCornerRadius="22.5dp"
        app:cardElevation="2dp">

        <ImageView
            android:id="@+id/img_pause_play"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:src="@android:drawable/ic_media_pause"
            app:tint="@android:color/black" />

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>